[Unit]
Description=Sellora PostgREST
Wants=network-online.target
After=network-online.target postgresql.service

[Service]
Type=simple
User=sellora
Group=sellora
WorkingDirectory=/opt/sellora/backend
EnvironmentFile=/etc/sellora/sellora.env
Environment=NODE_ENV=production
Environment=PATH=/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/node /opt/sellora/backend/scripts/run-postgrest.mjs
Restart=on-failure
RestartSec=3
StateDirectory=sellora
StateDirectoryMode=0750
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/sellora

[Install]
WantedBy=multi-user.target
