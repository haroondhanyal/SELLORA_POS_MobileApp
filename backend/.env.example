# Local PostgreSQL or a hosted PostgreSQL connection string. Keep server credentials here,
# never in the Expo app's EXPO_PUBLIC_* variables.
DATABASE_URL=postgresql://sellora_api:change-this-locally@127.0.0.1:5432/sellora
BETTER_AUTH_SECRET=replace-with-at-least-32-random-bytes
BETTER_AUTH_URL=http://localhost:4100
REST_JWT_SECRET=replace-with-a-different-random-secret-of-at-least-32-bytes
POSTGREST_URL=http://127.0.0.1:4101
PORT=4100
# LAN development lets Expo Go on another device reach the API. Production must
# change this to 127.0.0.1 and put the API behind the HTTPS Nginx proxy.
API_HOST=0.0.0.0
STORAGE_ROOT=.local/storage
POSTGREST_CONFIG_DIR=.local
# Optional PostgreSQL administrator socket and role for scripts/prepare-postgrest.mjs.
DATABASE_ADMIN_SOCKET=/tmp
DATABASE_ADMIN_USER=postgres
# Optional self-hosted mail delivery through a configured local sendmail-compatible MTA.
# MAIL_SENDMAIL_PATH=/usr/sbin/sendmail
# MAIL_FROM=Sellora <no-reply@yourdomain.com>
# Development example only. In production, set exact origins such as sellora:// and
# your HTTPS app origin. The server refuses wildcard/Expo/HTTP origins in production.
TRUSTED_ORIGINS=sellora://,exp://*
